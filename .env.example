# Environment configuration for the Docker Swarm stacks in this repository.
# Copy to .env and fill in the values. `docker stack deploy` does not read
# this file; export these variables in the shell before deploying.

# =============================================================================
# COMMON CONFIGURATION
# =============================================================================

# Container timezone
# Format: IANA timezone identifier
# Default: UTC
TIMEZONE=UTC

# Base domain for Traefik-routed hostnames (docker-compose.yml, compose.app.yml)
# Format: domain name without scheme or trailing slash
ROOT_DOMAIN=example.com

# Version suffix for Docker config names (traefik.yml_0, dynamic.yml_0)
# Increment to force a config redeployment when only config files changed
# Format: integer
# Default: 0
STACK_VERSION=0

# =============================================================================
# APP STACK CONFIGURATION (compose.app.yml)
# =============================================================================

# Telegram bot API token
# Format: <digits>:<35 characters>
# REQUIRED
BOT__TELEGRAM_TOKEN=<your-telegram-bot-token>

# Admin Telegram user ID receiving feedback and subscription notifications
# 0 disables both
# Format: integer
# Default: 0
BOT__ADMIN_TELEGRAM_ID=0

# Header carrying the original client IP behind Traefik
# Format: HTTP header name
# Default: X-Forwarded-For
HTTP__PROXY_HEADER=X-Forwarded-For

# Proxies trusted to set HTTP__PROXY_HEADER
# Format: JSON array of bare IPs or CIDR ranges; commas are not split
# Default: [] (proxy header ignored)
HTTP__PROXIES=[]

# =============================================================================
# INFRA STACK CONFIGURATION (docker-compose.yml)
# =============================================================================

# Traefik dashboard basic-auth credentials
# Format: htpasswd user:hash ($$ escapes $ for compose interpolation)
DASHBOARD_AUTH=admin:$$apr1$$hashed$$password

# NOTE: the external Docker secret `cloudflare.token` is required by Traefik
# for Let's Encrypt DNS-01 certificate issuance (traefik/traefik.yml).
# Create it on the swarm manager before deploying:
#   docker secret create cloudflare.token ./cloudflare.token
# Token permissions: Zone / Zone / Read + Zone / DNS / Edit, scoped to the zone.
